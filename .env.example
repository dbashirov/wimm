# Обязательно
DB_URL=postgres://wimm:wimm@localhost:5432/wimm?sslmode=disable

# Адрес HTTP-сервера (по умолчанию :8080)
SERVER_ADDR=:8080

# CSRF-секрет (минимум 16 байт). Если не задан — генерируется случайно
# при старте, что приведёт к разлогиниванию пользователей при перезапуске.
# Сгенерировать: openssl rand -base64 32
CSRF_SECRET=

# Пометить сессионную и CSRF-куку как Secure (только для HTTPS).
# В деве за HTTP установить COOKIE_INSECURE=true.
COOKIE_INSECURE=true

# Включить заголовок Strict-Transport-Security (только при HTTPS!).
HSTS=false

# Уровень логов: debug | info | warn | error (по умолчанию info)
LOG_LEVEL=info

# Формат логов: json (для прода) | text (для разработки)
LOG_FORMAT=text
